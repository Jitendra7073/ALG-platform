# =============================================================================
# Email System Environment Variables
# =============================================================================
# Copy this file to .env.local for local development
# DO NOT commit .env.local to version control

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database - PostgreSQL (Primary)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/email_system
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
PGHOST=localhost
PGPORT=5432
PGDATABASE=email_system
PGUSER=postgres
PGPASSWORD=your_password_here

# -----------------------------------------------------------------------------
# Database - SQLite (Legacy Read-only for migration)
# -----------------------------------------------------------------------------
# Path to existing SQLite database from the parent project
LEGACY_SQLITE_PATH=D:/wordpress site lead generator/old version/wordpress-detector.db

# -----------------------------------------------------------------------------
# Redis / BullMQ
# -----------------------------------------------------------------------------
# Redis connection for job queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# BullMQ Queue Configuration
BULLMQ_QUEUE_PREFIX=email-system
BULLMQ_CONCURRENCY=5
BULLMQ_MAX_RETRIES=3
BULLMQ_RETRY_BACKOFF_TYPE=exponential
BULLMQ_RETRY_BACKOFF_DELAY=1000

# -----------------------------------------------------------------------------
# Email Providers
# -----------------------------------------------------------------------------

# Resend (Transactional Email)
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# SendGrid (Transactional Email)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_SANDBOX_MODE=false

# SMTP (Custom/Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="Your Name"
SMTP_FROM_EMAIL=your@gmail.com

# -----------------------------------------------------------------------------
# Email Sending Configuration
# -----------------------------------------------------------------------------
# Default daily limits per sender
DEFAULT_DAILY_LIMIT=50
# Maximum emails per batch
MAX_BATCH_SIZE=10
# Delay between emails in batch (milliseconds)
BATCH_DELAY_MS=2000
# Maximum retries for failed emails
MAX_EMAIL_RETRIES=3
# Retry backoff multiplier
RETRY_BACKOFF_MULTIPLIER=2

# -----------------------------------------------------------------------------
# Timezone & Scheduling
# -----------------------------------------------------------------------------
# Default timezone for scheduling (IANA format)
DEFAULT_TIMEZONE=America/New_York
# Business hours for sending (24h format)
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
# Days to avoid sending (0=Sunday, 6=Saturday)
SKIP_WEEKENDS=false
SKIP_DAYS=

# -----------------------------------------------------------------------------
# OpenRouter AI (for content processing)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# Next.js
# -----------------------------------------------------------------------------
# For standalone dashboard connecting to parent API server
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Sentry for error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Log level: debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Maximum requests per IP per window
RATE_LIMIT_MAX=100
# Time window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Webhooks (optional)
# -----------------------------------------------------------------------------
# Webhook URL for email events
WEBHOOK_URL_EMAIL_EVENTS=
# Webhook secret for signature verification
WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Deployment - Railway
# -----------------------------------------------------------------------------
# Railway automatically provides these
RAILWAY_ENVIRONMENT=
RAILWAY_SERVICE_NAME=
RAILWAY_PROJECT_ID=

# -----------------------------------------------------------------------------
# Deployment - Vercel
# -----------------------------------------------------------------------------
# Vercel automatically provides these
VERCEL_ENV=
VERCEL_URL=
VERCEL_GIT_COMMIT_SHA=
