# ============================================
# ENVIRONMENT VARIABLES EXAMPLE FILE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# DATABASE (Required for Vercel deployment)
# ============================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# ============================================
# AI SERVICES (Optional)
# ============================================
# OpenRouter API for AI content verification
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# ============================================
# EMAIL SERVICES (Optional)
# ============================================
# Gmail SMTP for sending emails
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_app_specific_password

# ============================================
# DEPLOYMENT SETTINGS
# ============================================
NODE_ENV=production
PORT=8080

# ============================================
# VERCEL-SPECIFIC (Optional)
# ============================================
# Chrome user data directory path (only for local development)
CHROME_USER_DATA_DIR=C:\automation_chrome

# ============================================
# NOTES
# ============================================
# 1. For Vercel deployment, add DATABASE_URL in Vercel dashboard
# 2. Never commit real credentials to .env or .env.example
# 3. Keep .env in .gitignore
# 4. Test locally with `npm run admin` before deploying
# 5. Check VERCEL_DEPLOYMENT.md for deployment guide